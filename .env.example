# The API listens on this host-only port for your HTTPS reverse proxy.
APP_PORT=3000
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_DATABASE=qr2share
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Canonical origin for new dynamic QR scan links (use a reachable hostname).
PUBLIC_URL=https://api.example.com
CORS_ORIGIN=https://example.com

# Only used by deploy/compose.live.yml; CI replaces this with the release SHA tag.
QR2SHARE_IMAGE=qr2share:sha-REPLACE_WITH_COMMIT_SHA
