{
  "name": "print-prank",
  "version": "1.0.0",
  "description": "A game about trying to guess who a football player is.",
  "main": "index.js",
  "scripts": {
    "test": "node --require ts-node/register --test tests/*.test.js",
    "mongodb": "docker run -d -p 27017:27017 --name local-mongo -e MONGO_INITDB_ROOT_USERNAME=root -e MONGO_INITDB_ROOT_PASSWORD=G0407 -e MONGO_INITDB_DATABASE=print-prank custom-mongo",
    "mongodb:stop": "docker stop local-mongo && docker rm local-mongo",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run dev:client\"",
    "build:server": "tsc",
    "build:client": "npm --prefix client run build",
    "test:ui": "npm --prefix client test",
    "lint": "eslint src client/src client/tests client/*.ts tests public/scan/collect.js eslint.config.mjs --max-warnings=0",
    "lint:fix": "npm run lint -- --fix"
  },
  "author": "Goce Jovancevski",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/lodash": "^4.17.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.1",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "concurrently": "^9.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@types/mongoose": "^5.11.96",
    "axios": "^1.7.7",
    "bcrypt-nodejs": "^0.0.3",
    "connect-redis": "^8.0.1",
    "cors": "^2.8.5",
    "device-fingerprint": "^1.2.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "fetch": "^1.1.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jimp": "^1.6.0",
    "lodash": "^4.17.21",
    "mongoose": "^8.8.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9"
  }
}
